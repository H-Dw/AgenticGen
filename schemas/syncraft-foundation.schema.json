{
  "$defs": {
    "EditConstraints": {
      "additionalProperties": false,
      "description": "Prompt guidance; native SynCraft reconstruction does not enforce these limits.",
      "properties": {
        "max_operations": {
          "default": 6,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Operations",
          "type": "integer"
        },
        "max_added_atoms": {
          "default": 2,
          "minimum": 0,
          "title": "Max Added Atoms",
          "type": "integer"
        },
        "max_deleted_atoms": {
          "default": 2,
          "minimum": 0,
          "title": "Max Deleted Atoms",
          "type": "integer"
        },
        "min_similarity": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Similarity",
          "type": "number"
        },
        "allowed_elements": {
          "default": [
            "C",
            "N",
            "O",
            "F",
            "P",
            "S",
            "Cl",
            "Br",
            "I"
          ],
          "items": {
            "type": "string"
          },
          "title": "Allowed Elements",
          "type": "array"
        },
        "protected_atom_maps": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Protected Atom Maps",
          "type": "array"
        }
      },
      "title": "EditConstraints",
      "type": "object"
    },
    "EnhancementConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "packets_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packets File"
        },
        "allowed_kinds": {
          "default": [
            "flow_history"
          ],
          "items": {
            "enum": [
              "flow_history",
              "native_exploration",
              "case_memory"
            ],
            "type": "string"
          },
          "title": "Allowed Kinds",
          "type": "array"
        },
        "max_characters": {
          "default": 16000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Characters",
          "type": "integer"
        }
      },
      "title": "EnhancementConfig",
      "type": "object"
    },
