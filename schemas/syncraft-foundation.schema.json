      "type": "string"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "mode": {
      "default": "standard",
      "enum": [
        "standard",
        "interaction_aware",
        "dual"
      ],
      "title": "Mode",
      "type": "string"
    },
    "pass_k": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Pass K",
      "type": "integer"
    },
    "syncraft": {
      "$ref": "#/$defs/SynCraftConfig"
    },
    "llm": {
      "$ref": "#/$defs/FoundationLLM"
    },
    "retro": {
      "$ref": "#/$defs/RetroConfig",
      "default": {
        "backend": "disabled",
        "root": null,
        "python": null,
        "execution": "python",
        "image": "agenticgen-simpretro-worker:20261016",
        "inventory": null,
        "templates": null,
        "fingerprint_cache": null,
        "inventory_index": null,
        "time_limit_seconds": 1800,
        "process_grace_seconds": 300,
        "cpu_threads": 1,
        "seed": 0,
        "expected_revision": null
