* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
# Preserve scientific input bytes and fixed-width record padding across hosts.
*.sdf -text -whitespace
*.pdb -text -whitespace
*.pdbqt -text -whitespace
*.cfg -text
.gitignore text eol=lf
.gitattributes text eol=lf
